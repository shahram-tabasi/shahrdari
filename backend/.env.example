# ─────────────────────────────────────────────────────────────────────────────
# Environment template.
#
# Copy to `.env` for local development. NEVER commit a filled-in `.env`, and
# never put a real secret in this file — «هیچ داده محرمانه‌ای نباید داخل کد،
# فایل تنظیمات عمومی یا ریپازیتوری وجود داشته باشد». In deployed environments
# these values are injected at run time from a secrets manager (HashiCorp
# Vault, Azure Key Vault, or Kubernetes Secrets with appropriate controls).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Security ────────────────────────────────────────────────────────────────

# Browser origins allowed to call this API, comma-separated. There is no
# wildcard: an unlisted origin is rejected.
#
# Vite starts on 5173 and increments when that port is taken, so development
# covers 5173-5176. In production replace this with the single real front-end
# origin and remove the localhost entries.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

# HMAC key for session tokens and for sealing the audit chain. At least 32
# characters. REQUIRED in production — the server refuses to start without it
# rather than falling back to a generated key.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Session lifetime in minutes.
SESSION_TTL_MINUTES=60

# Request body size cap. Deliberately small; nothing this API accepts is large.
JSON_BODY_LIMIT=256kb

# Directory for the tamper-evident audit log. In production this should be a
# mount that the application user can append to but not rewrite, feeding a
# central WORM log sink.
AUDIT_LOG_DIR=./var/audit

# ── Rate limiting ───────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# ── Language model (optional) ───────────────────────────────────────────────
#
# Leave LLM_API_KEY empty to run without the assistant. Screening, weighting,
# ranking, portfolio optimisation and sensitivity analysis all work with no
# model configured — the assistant endpoints simply report that they are
# unavailable and explain the degraded mode.

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Point this at an internally hosted, OpenAI-compatible endpoint (vLLM, Ollama,
# LM Studio, or an internal gateway) to keep municipality data on-premises.
# Leave empty to use the provider's default hosted endpoint.
LLM_BASE_URL=

# The legacy OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL names are still
# accepted, so an existing .env keeps working. Prefer the LLM_* names above.

# Whether project narrative text may be sent to an external model. Defaults to
# false: the data-governance rules require an explicit decision on whether
# documents leave the network, and the safe default is that they do not.
AI_ALLOW_EXTERNAL_DOCUMENTS=false

# Unbounded-consumption controls. The request cap bounds how often the model
# can be called; the token budget bounds what those calls may cost. Both are
# needed — neither alone bounds spend.
AI_RATE_LIMIT_WINDOW_SECONDS=300
AI_RATE_LIMIT_MAX_REQUESTS=15
AI_MAX_INPUT_CHARACTERS=8000
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_TOKEN_BUDGET=200000
